generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  DEMO
  PAID
}

enum Choice {
  A
  B
  C
  D
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

enum JobKind {
  INITIAL
  REGENERATE
}

enum DebugReportKind {
  BUG
  FEEDBACK
  TECHNICAL
}

enum SubmissionStatus {
  NEW
  ANALYZED
  IMPORTED
  REJECTED
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           Role      @default(USER)
  plan           Plan      @default(DEMO)
  createdAt      DateTime  @default(now())
  fullName         String?
  hospitalName     String?
  residencyYear    Int?
  locale           String    @default("he")
  examDate         DateTime?
  questionsPerWeek Int?
  lastDailyPopupAt DateTime?
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  localPdfSetAt    DateTime? // last time the user selected a local textbook PDF (client-reported)
  forumLastVisitedAt DateTime? // last time the user opened חדר מתמחים (for new-thread highlighting)

  accounts      Account[]
  sessions      Session[]
  attempts      Attempt[]
  quizzes       Quiz[]
  forumThreads  ForumThread[]            @relation("ForumThreadAuthor")
  forumReplies  ForumReply[]             @relation("ForumReplyAuthor")
  reports           AnswerReport[]           @relation("ReportAuthor")
  resolved          AnswerReport[]           @relation("ReportResolver")
  questions         Question[]               @relation("QuestionAuthor")
  bookmarks         Bookmark[]
  generationJobs    AnswerGenerationJob[]    @relation("JobCreator")
  sentenceHighlights SentenceHighlight[]
  debugReports      DebugReport[]            @relation("DebugReportAuthor")
  resolvedDebugReports DebugReport[]         @relation("DebugReportResolver")
  adminNotes        QuestionAdminNote[]      @relation("AdminNoteAuthor")
  dailyPopupAcks    DailyPopupAck[]
  activityPings     ActivityPing[]
  submissions       QuestionSubmission[]     @relation("SubmissionAuthor")
  reviewedSubmissions QuestionSubmission[]   @relation("SubmissionReviewer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Chapter {
  id                       Int            @id @default(autoincrement())
  number                   Int            @unique
  title                    String
  description              String         @db.Text
  ingestedAt               DateTime?
  learningUsefulnessIndex  Int?
  questions                Question[]
  chunks                   ChapterChunk[]
}

model ChapterChunk {
  id           Int                          @id @default(autoincrement())
  chapterId    Int
  ord          Int
  text         String                       @db.Text
  embedding    Unsupported("vector(1536)")?
  // v2 ingestion metadata (nullable for back-compat with chunks ingested by the v1 pipeline)
  sectionPath  String?
  headingLevel Int?
  pageStart    Int?
  pageEnd      Int?
  tokenCount   Int?
  chapter      Chapter                      @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, ord])
}

model Question {
  id                Int           @id @default(autoincrement())
  chapterId         Int           // primary chapter (admin-overridable; derived from RAG evidence by default)
  chapterIds        Int[]         @default([]) // all chapters whose evidence supports the answer (unranked set; includes primary)
  chapterAutoTagged Boolean       @default(true)  // false once admin manually overrides classification
  stem              String        @db.Text
  stemEn            String?       @db.Text  // precomputed English mirror of the stem for cross-language retrieval
  optionA           String        @db.Text
  optionB           String        @db.Text
  optionC           String        @db.Text
  optionD           String        @db.Text
  correctAnswer     Choice?
  acceptedAnswers   Choice[]      @default([])  // additional answers an admin has marked as accepted alongside `correctAnswer` (e.g. when a question has more than one valid answer); the primary `correctAnswer` is always accepted and is excluded from this array
  source            String?
  disabled          Boolean       @default(false)  // when true, question is hidden from learners; admin still sees it
  adminApproved     Boolean       @default(false)  // when true, bypasses the publish-confidence threshold gate (admin manually verified the answer)
  imageUrl          String?       // public URL for an attached image (Firebase Storage)
  imagePath         String?       // storage object path, used to delete/replace
  imageAlt          String?       // optional alt text for accessibility
  videoUrl          String?       // external video URL (YouTube, Vimeo, or direct mp4)
  createdById       String?
  createdAt         DateTime      @default(now())

  chapter       Chapter       @relation(fields: [chapterId], references: [id])
  createdBy     User?         @relation("QuestionAuthor", fields: [createdById], references: [id])
  geminiAnswer  GeminiAnswer?
  geminiAnswerCandidate GeminiAnswerCandidate?
  attempts      Attempt[]
  forumThread     ForumThread?
  reports         AnswerReport[]
  bookmarks       Bookmark[]
  ragRuns         RagRun[]
  generationJobs  AnswerGenerationJob[]
  sentenceHighlights SentenceHighlight[]
  debugReports    DebugReport[]
  adminNotes      QuestionAdminNote[]

  @@index([chapterId])
  @@index([chapterIds], type: Gin)
}

/// Admin-only free-form notes attached to a question (audit/log/comments).
/// Visible only inside /admin routes.
model QuestionAdminNote {
  id         Int      @id @default(autoincrement())
  questionId Int
  authorId   String?
  body       String   @db.Text
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author     User?    @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([questionId, createdAt])
}

model GeminiAnswer {
  id                 Int      @id @default(autoincrement())
  questionId         Int      @unique
  rawMarkdown        String   @db.Text
  correctAnswer      Choice
  evidence           String   @db.Text
  explanation        String   @db.Text
  whyOthersWrong     String   @db.Text
  model              String
  sourceChapters     Int[]    @default([])
  // v2 structured-output fields
  evidenceCitations  Json?    // EvidenceCitation[] — { chapterNumber, chapterTitle, sectionPath?, quote }
  confidence         Float?
  escalated          Boolean  @default(false)
  insufficientEvidence Boolean @default(false)
  // Last admin hint/context (רמז) supplied to the generator for this answer, if any.
  // Null when the answer was generated without a hint. Overwritten on each regeneration.
  generationHint     String?  @db.Text
  // Optional image an admin manually attaches to the explanation (Firebase Storage)
  explanationImageUrl  String?  // public URL for the attached explanation image
  explanationImagePath String?  // storage object path, used to delete/replace
  explanationImageAlt  String?  // optional alt text for accessibility
  generatedAt        DateTime @default(now())

  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

/// Staged regeneration result. When an admin runs a REGENERATE job we write
/// the new payload here instead of overwriting `GeminiAnswer`. Admins compare
/// it against the live answer in /admin/candidates and either accept (which
/// replaces the live answer) or discard.
model GeminiAnswerCandidate {
  id                   Int      @id @default(autoincrement())
  questionId           Int      @unique
  jobId                Int?     @unique
  rawMarkdown          String   @db.Text
  correctAnswer        Choice
  evidence             String   @db.Text
  explanation          String   @db.Text
  whyOthersWrong       String   @db.Text
  model                String
  sourceChapters       Int[]    @default([])
  evidenceCitations    Json?
  confidence           Float?
  escalated            Boolean  @default(false)
  insufficientEvidence Boolean  @default(false)
  // Last admin hint/context (רמז) supplied to the generator for this candidate, if any.
  generationHint       String?  @db.Text
  // Proposed chapter retag (only applied to Question on accept, and only if chapterAutoTagged).
  derivedChapterIds    Int[]    @default([])
  primaryChapterId     Int?
  generatedAt          DateTime @default(now())

  question Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  job      AnswerGenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
}

/// Cache of RAG results keyed by a hash of the normalized stem+options.
/// Board questions often repeat — a cache hit lets us clone the GeminiAnswer payload
/// without re-embedding the query or re-calling the generation model.
model QuestionQueryCache {
  id           Int      @id @default(autoincrement())
  questionHash String   @unique
  payload      Json     // serialized v2 GeminiAnswer structured payload
  createdAt    DateTime @default(now())
  hits         Int      @default(0)
}

/// Sources of questions visible to DEMO-plan users. Presence = allowed.
/// The sentinel value "__NULL__" represents questions with no source.
model DemoAllowedSource {
  id        String   @id @default(cuid())
  source    String   @unique
  createdAt DateTime @default(now())
}

/// Editable site content managed by admins (key→value store for pages like /about)
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Announcements shown in the top banner. When multiple are enabled they rotate.
model Announcement {
  id        String   @id @default(cuid())
  message   String   @db.Text
  ctaLabel  String?
  ctaHref   String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, createdAt])
}

/// Modal popups shown at most once per day per signed-in user.
/// Users can permanently dismiss with the acknowledge button (DailyPopupAck);
/// the X button only suppresses for the current day via User.lastDailyPopupAt.
model DailyPopup {
  id        String   @id @default(cuid())
  title     String   @db.Text
  body      String   @db.Text
  ctaLabel  String?
  ctaHref   String?
  enabled   Boolean  @default(true)
  /// When set (by an admin "force show" action), this popup takes priority over
  /// the daily rotation and is shown to every eligible user that hasn't acked it.
  forcedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acks DailyPopupAck[]

  @@index([enabled, createdAt])
}

/// Permanent acknowledgement of a DailyPopup by a user ("ראיתי, תודה").
model DailyPopupAck {
  userId         String
  popupId        String
  acknowledgedAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  popup DailyPopup @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@id([userId, popupId])
  @@index([userId])
}

/// Observability log for every RAG generation invocation.
model RagRun {
  id              Int      @id @default(autoincrement())
  questionId      Int
  model           String   // final model that produced the persisted answer
  kPrimary        Int      // candidates retrieved before reranking
  kReranked       Int      // chunks fed to the generator
  rerankerScores  Float[]
  escalated       Boolean  @default(false)
  cacheHit        Boolean  @default(false)
  latencyMs       Int?
  tokensIn        Int?
  tokensOut       Int?
  costCents       Float?
  createdAt       DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
}

model Attempt {
  id         Int      @id @default(autoincrement())
  userId     String
  questionId Int
  chosen     Choice
  isCorrect  Boolean
  eliminated Choice[] @default([])
  quizId     Int?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quiz       Quiz?    @relation(fields: [quizId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([questionId])
}

model ActivityPing {
  id        Int      @id @default(autoincrement())
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Quiz {
  id          Int       @id @default(autoincrement())
  userId      String
  name        String
  chapterIds  Int[]
  questionIds Int[]     @default([])
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts    Attempt[]
}

/// A discussion thread. Two flavours sharing one table:
///  - Free topic: `title` + `body` + `authorId` set, `questionId` null.
///  - Question discussion: `questionId` set (title is rendered live from the question stem),
///    `title`/`body`/`authorId` null. This is the single source of truth for a question's
///    "תגובות קהילה" — replies appear both on the question page and in the forum.
model ForumThread {
  id          String       @id @default(cuid())
  title       String?
  body        String?      @db.Text
  authorId    String?
  questionId  Int?         @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lastReplyAt DateTime     @default(now())

  author    User?       @relation("ForumThreadAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  question  Question?   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  replies   ForumReply[]

  @@index([lastReplyAt])
}

model ForumReply {
  id        String      @id @default(cuid())
  threadId  String
  authorId  String
  body      String      @db.Text
  createdAt DateTime    @default(now())
  editedAt  DateTime?

  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User        @relation("ForumReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AnswerReport {
  id              Int          @id @default(autoincrement())
  questionId      Int
  userId          String
  explanation     String       @db.Text
  status          ReportStatus @default(OPEN)
  createdAt       DateTime     @default(now())
  resolvedById    String?
  adminResponse   String?      @db.Text
  adminResponseAt DateTime?
  adminResponseSeenAt DateTime?

  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user         User         @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  resolver     User?        @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// User-submitted debug / feedback / technical reports surfaced from /study/report.
model DebugReport {
  id            Int             @id @default(autoincrement())
  userId        String
  kind          DebugReportKind
  category      String?
  description   String          @db.Text
  chapterNumber Int?
  questionId    Int?
  pageUrl       String?
  contactEmail  String?
  status        ReportStatus    @default(OPEN)
  createdAt     DateTime        @default(now())
  resolvedById  String?
  resolvedAt    DateTime?
  adminResponse   String?       @db.Text
  adminResponseAt DateTime?
  adminResponseSeenAt DateTime?

  user      User      @relation("DebugReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  resolver  User?     @relation("DebugReportResolver", fields: [resolvedById], references: [id])
  question  Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Bookmark {
  id         Int      @id @default(autoincrement())
  userId     String
  questionId Int
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, createdAt])
}

/// Per-user sentence-level highlights inside the AnswerExplanation card.
/// Anchored to (questionId, section, sentenceIndex) within the rendered markdown,
/// scoped per content-locale. sentenceHash detects admin edits → render as "stale".
/// sentenceText is denormalized so /bookmarks can render without re-fetching the source.
model SentenceHighlight {
  id            Int      @id @default(autoincrement())
  userId        String
  questionId    Int
  locale        String   // "he" | "en"
  section       String   // "EXPLANATION" | "WHY_WRONG_A".."WHY_WRONG_D"
  sentenceIndex Int      // 0-based within the section's split
  colorId       Int      // 1..4
  sentenceHash  String   // sha1 (first 16 hex chars) of normalized sentence text
  sentenceText  String   @db.Text
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId, locale, section, sentenceIndex])
  @@index([userId, createdAt])
  @@index([userId, questionId, locale])
}

/// Persistent translation cache. Source of truth is always Hebrew; English is machine-translated on demand.
model Translation {
  id           String   @id @default(cuid())
  entityType   String   // e.g. "Question" | "GeminiAnswer" | "Chapter" | "SiteContent"
  entityId     String   // stringified pk
  field        String   // e.g. "stem" | "optionA" | "explanation" | "whyOthersWrong" | "title"
  locale       String   // target locale, e.g. "en"
  sourceHash   String   // sha256 of the Hebrew source text — stale when source changes
  text         String   @db.Text
  provider     String   @default("gemini") // "gemini" | "manual"
  reviewed     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, entityId, locale])
}

model AnswerGenerationJob {
  id          Int        @id @default(autoincrement())
  questionId  Int
  status      JobStatus  @default(PENDING)
  kind        JobKind    @default(INITIAL)
  attempts    Int        @default(0)
  lastError   String?    @db.Text
  queuedAt    DateTime   @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdById String?
  regenerationHint String? @db.Text

  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdBy   User?      @relation("JobCreator", fields: [createdById], references: [id])
  candidate   GeminiAnswerCandidate?

  @@index([status, queuedAt])
  @@index([questionId])
}

/// Raw question sets submitted by visitors (including non-authenticated) via /contribute.
/// Admins review the raw dump, run a Gemini standardization pass, then import the
/// resulting questions into the generation queue ("מרכז התור").
model QuestionSubmission {
  id             String           @id @default(cuid())
  // Raw content — the analysis source is rawText (paste) or extractedText (uploaded file).
  rawText        String?          @db.Text // pasted "dump" of questions + answers
  fileName       String?                   // original uploaded file name (logged-in upload)
  extractedText  String?          @db.Text // text extracted from an uploaded PDF/Word file
  // Submitter-provided metadata
  institute      String                     // required
  year           Int?
  suffix         String?                    // optional exam group ("קבוצה"), e.g. "א", "מועד א"
  chapterHint    String?                    // free-text chapter / topic
  doctorName     String?
  // Submitter identity (submittedBy set only when authenticated)
  submittedById  String?
  submitterEmail String?
  // Review workflow
  status         SubmissionStatus @default(NEW)
  analysis       Json?                      // StandardizedQuestion[] produced by the Gemini pass
  analyzedAt     DateTime?
  importedCount  Int              @default(0)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())

  submittedBy User? @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User? @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
