DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"

GEMINI_API_KEY=""
GEMINI_GENERATION_MODEL="gemini-2.5-pro"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Firebase Storage — used for question image uploads
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
# Either set the full service-account JSON inline (recommended for hosted envs)…
FIREBASE_SERVICE_ACCOUNT_JSON=""
# …or set GOOGLE_APPLICATION_CREDENTIALS to a path on disk and leave the JSON blank.
