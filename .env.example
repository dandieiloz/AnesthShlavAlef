DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"

GEMINI_API_KEY=""
GEMINI_GENERATION_MODEL="gemini-3.1-pro-preview"
GEMINI_FLASH_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# Reasoning depth for answer generation: minimal | low | medium | high (default high)
# GEMINI_GEN_THINKING_LEVEL="high"

# Firebase Storage — used for question image uploads
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
# Either set the full service-account JSON inline (recommended for hosted envs)…
FIREBASE_SERVICE_ACCOUNT_JSON=""
# …or set GOOGLE_APPLICATION_CREDENTIALS to a path on disk and leave the JSON blank.
